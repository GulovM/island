#pragma code_page(65001)

// ISLAND_VER_COMMA ("0,1,1,0") и ISLAND_VER ("0.1.1") передаёт build.rs из Cargo.toml.
#ifndef ISLAND_VER_COMMA
#define ISLAND_VER_COMMA 0,0,0,0
#define ISLAND_VER "0.0.0"
#endif

// Иконка exe (Проводник, диспетчер задач). Значок в трее рисуется кодом (sys::make_icon).
1 ICON "assets/island.ico"

// Манифест: Windows 10/11, Per-Monitor V2, длинные пути, UTF-8.
1 24 "island.manifest"

1 VERSIONINFO
FILEVERSION ISLAND_VER_COMMA
PRODUCTVERSION ISLAND_VER_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription", "Island — динамический остров для Windows 10/11"
            VALUE "FileVersion", ISLAND_VER
            VALUE "InternalName", "island"
            VALUE "OriginalFilename", "island.exe"
            VALUE "ProductName", "Island"
            VALUE "ProductVersion", ISLAND_VER
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END

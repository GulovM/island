#pragma code_page(65001)

// Иконка exe (Проводник, диспетчер задач). Значок в трее рисуется кодом (sys::make_icon).
1 ICON "assets/island.ico"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription", "Island — динамический остров для Windows 11"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "island"
            VALUE "OriginalFilename", "island.exe"
            VALUE "ProductName", "Island"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END
